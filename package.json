{
  "name": "@qgynisc/dsh-inline-pastes",
  "version": "0.5.2",
  "description": "把粘贴的图片作为「名字胶囊」插进文字里，悬浮名字即可预览缩略图（DeepSeek Harness Web GUI 客户端插件）",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-ui",
    "paste",
    "attachment",
    "inline-image"
  ],
  "author": "qgynisc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qgynisc/dsh-inline-pastes.git"
  },
  "homepage": "https://github.com/qgynisc/dsh-inline-pastes#readme",
  "bugs": {
    "url": "https://github.com/qgynisc/dsh-inline-pastes/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.en.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node tests/run-all.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:ci": "node scripts/build.mjs && node --test tests/unit/*.test.mjs && node scripts/verify-install.mjs --simulate",
    "verify:browser": "node scripts/verify-browser.mjs",
    "install:desktop": "node scripts/install.mjs --profile desktop",
    "uninstall:desktop": "node scripts/install.mjs --profile desktop --uninstall"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "tag-version-prefix": "v"
}
